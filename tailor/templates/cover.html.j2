{#
  Portfolio-style cover letter.

  Structured sections rather than prose paragraphs, with the employer's own
  logo and colours in the letterhead. Both are derived from their published
  favicon (see tailor/branding.py) — never invented, and falling back to a
  restrained slate when nothing can be read.

  The brand colour is used as an accent only: rules, section marks, the
  letterhead band. Body text stays near-black, because a letter set in a
  company's brand colour reads as a mock-up rather than a document.

  Still one page. `render_cover` rejects it otherwise.
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ profile.name }} — {{ job.company }}</title>
<style>
  {% set s = scale | default(1.0) %}
  @page { size: 612pt 792pt; margin: {{ (30 * s)|round(1) }}pt 34pt 24pt 34pt; }

  :root { --accent: {{ brand.accent }}; --second: {{ brand.secondary }}; }

  body {
    font-family: "Nimbus Roman", "Times", "Liberation Serif", serif;
    font-size: {{ (10.3 * s)|round(2) }}pt;
    line-height: {{ (14.6 * s)|round(2) }}pt;
    margin: 0;
    color: #14181f;
  }

  /* -- letterhead -------------------------------------------------------- */

  .head { width: 100%; border-collapse: collapse; }
  .head td { vertical-align: middle; padding: 0; }

  .who .name {
    font-size: 17pt;
    font-weight: bold;
    line-height: 19pt;
    letter-spacing: -0.2pt;
  }
  .who .tagline {
    font-size: 9pt;
    color: #55606e;
    margin-top: 1pt;
  }
  .who .contact { font-size: 8.8pt; color: #55606e; margin-top: 3pt; }
  .who .contact a { color: #55606e; text-decoration: none; }

  .mark { text-align: right; white-space: nowrap; }
  .mark img { max-height: 34pt; max-width: 128pt; }
  .mark .co {
    font-size: 8.4pt;
    font-weight: bold;
    letter-spacing: 0.10em;
    color: {{ brand.accent }};
    margin-top: 3pt;
  }

  .band {
    height: 4pt;
    background: {{ brand.accent }};
    margin: 8pt 0 0 0;
  }
  .band-sub {
    height: 1pt;
    background: {{ brand.secondary }};
    opacity: 0.45;
    margin-bottom: 11pt;
  }

  /* -- role line --------------------------------------------------------- */

  .role {
    font-size: 11.6pt;
    font-weight: bold;
    margin-bottom: 1pt;
  }
  .role-meta { font-size: 9pt; color: #55606e; margin-bottom: 12pt; }

  /* -- sections ---------------------------------------------------------- */

  h2 {
    font-family: "Nimbus Sans", "Helvetica", "Liberation Sans", sans-serif;
    font-size: 8.3pt;
    font-weight: bold;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: {{ brand.accent }};
    margin: {{ (15 * s)|round(1) }}pt 0 {{ (6 * s)|round(1) }}pt 0;
    padding-bottom: 2pt;
    border-bottom: 0.6pt solid rgba(0,0,0,0.14);
  }

  p { margin: 0 0 {{ (6 * s)|round(1) }}pt 0; }

  .hook {
    font-size: {{ (11.4 * s)|round(2) }}pt;
    line-height: {{ (16 * s)|round(2) }}pt;
    margin-bottom: 2pt;
  }

  /* -- what I bring: three stacked rows with a coloured rule -------------- */

  .brings { width: 100%; border-collapse: collapse; }
  .brings td { padding: 0 0 {{ (8 * s)|round(1) }}pt 0; vertical-align: top; }
  .brings .t {
    width: 122pt;
    padding-right: 10pt;
    font-weight: bold;
    border-left: 2.2pt solid {{ brand.accent }};
    padding-left: 6pt;
  }
  .brings .d { color: #262d38; }

  /* -- selected work: two cards side by side ----------------------------- */

  .work { width: 100%; border-collapse: separate; border-spacing: 8pt 0; }
  .work td {
    width: 50%;
    vertical-align: top;
    padding-bottom: 9pt;
    background: rgba(0,0,0,0.028);
    border-top: 2pt solid {{ brand.secondary }};
    padding: 6pt 8pt 7pt 8pt;
  }
  .work .n { font-weight: bold; font-size: 9.8pt; }
  .work .s {
    font-size: 8pt;
    color: #55606e;
    font-style: italic;
    margin: 1pt 0 3pt 0;
  }
  .work .d { font-size: 9.8pt; line-height: 13.4pt; }

  /* -- signature --------------------------------------------------------- */

  .tools {
    font-size: 9.4pt;
    color: #262d38;
    line-height: 15pt;
  }

  .signoff { margin-top: {{ (14 * s)|round(1) }}pt; font-size: 10.3pt; }
  .signoff .name { font-weight: bold; }
  .foot {
    margin-top: 7pt;
    padding-top: 5pt;
    border-top: 0.6pt solid rgba(0,0,0,0.14);
    font-size: 8pt;
    color: #6b7480;
  }
</style>
</head>
<body>

<table class="head"><tr>
  <td class="who">
    <div class="name">{{ profile.name }}</div>
    <div class="tagline">{{ tagline }}</div>
    <div class="contact">
      {{ profile.contact.email }} &nbsp;·&nbsp; {{ profile.contact.phone }}
      {%- for link in profile.contact.links %} &nbsp;·&nbsp; <a href="{{ link.url }}">{{ link.text }}</a>{% endfor %}
    </div>
  </td>
  <td class="mark">
    {% if brand.logo %}<img src="{{ brand.logo }}" alt="{{ job.company }}">{% endif %}
    <div class="co">{{ job.company|upper }}</div>
  </td>
</tr></table>

<div class="band"></div>
<div class="band-sub"></div>

<div class="role">{{ job.title }}</div>
<div class="role-meta">
  {{ job.locations|join(", ") if job.locations else "Location unspecified" }}
  {%- if job.terms %} &nbsp;·&nbsp; {{ job.terms|join(", ") }}{% endif %}
</div>

<p class="hook">{{ letter.hook }}</p>

<h2>Why {{ job.company }}</h2>
<p>{{ letter.why_company }}</p>

<h2>What I bring</h2>
<table class="brings">
  {% for item in letter.what_i_bring %}
  <tr>
    <td class="t">{{ item.title }}</td>
    <td class="d">{{ item.detail }}</td>
  </tr>
  {% endfor %}
</table>

<h2>Selected work</h2>
<table class="work"><tr>
  {% for item in letter.selected_work %}
  <td>
    <div class="n">{{ item.name }}</div>
    {% if item.stack %}<div class="s">{{ item.stack }}</div>{% endif %}
    <div class="d">{{ item.detail }}</div>
  </td>
  {% endfor %}
</tr></table>

<h2>Toolkit</h2>
<p class="tools">{{ skills }}</p>

<div class="signoff">
  Sincerely,<br>
  <span class="name">{{ profile.name }}</span>
</div>

<div class="foot">{{ letter.closing }}</div>

</body>
</html>
