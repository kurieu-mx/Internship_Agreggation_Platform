# Copy to .env and fill in. .env is git-ignored — never commit real credentials.

# --- Filters ---------------------------------------------------------------
# Term to keep (substring match). Leave empty to keep every term.
TERM_FILTER=Summer 2026
# Set to false to include postings the upstream source has marked closed.
ACTIVE_ONLY=true

# --- Ollama (optional, only used with --enrich) -----------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Google Sheets (optional, only used with --sheets) ----------------------
# Path to a service-account key JSON. Share the spreadsheet with the service
# account's client_email address so it can write.
GOOGLE_CREDENTIALS_FILE=credentials.json
# The long id from the spreadsheet URL: docs.google.com/spreadsheets/d/<ID>/edit
SPREADSHEET_ID=
SHEET_NAME=Internships
