# Copy to .env and fill in. .env is git-ignored — never commit real credentials.
#
# Run `python main.py --doctor` after editing; it reports exactly what is still
# missing and the command that fixes each one.

# =============================================================================
# REQUIRED for the daily digest
# =============================================================================

# Scoring and tailoring. Get one at https://platform.claude.com
ANTHROPIC_API_KEY=

# Web search + Gmail delivery. Get one at https://app.composio.dev
COMPOSIO_API_KEY=
# Must match the user id you connected Gmail under in the Composio dashboard.
COMPOSIO_USER_ID=default

# Where the digest is sent.
DIGEST_TO=kurieu@umich.edu

# =============================================================================
# OPTIONAL
# =============================================================================

# Handshake sees UMich-restricted postings, but needs a session cookie you
# export from your own logged-in browser, and it expires every few weeks.
# Currently OFF - `handshake` is not in SOURCES below. To turn it on: add it
# to SOURCES, then run
#     python main.py --import-cookie /tmp/hs.txt   (a 'Copy as cURL' dump)
#     make handshake
HANDSHAKE_COOKIE=
HANDSHAKE_HOST=umich.joinhandshake.com

# =============================================================================
# MODELS — split by what each call does, not to shave the bill
# =============================================================================
# Measured at ~$0.54/day / ~$16 a month with these defaults. Re-measure after
# any change with `make costs` (token counting is free).

# Decides which companies you apply to — the highest-leverage call here.
MODEL_SCORING=claude-opus-5
# Writes the resume and cover letter — documents a human judges you on.
MODEL_TAILORING=claude-opus-5
# Pulls facts out of a careers page. Pure extraction, and the output is
# validated against the source before it reaches a letter.
MODEL_RESEARCH=claude-haiku-4-5
# low | medium | high | xhigh | max
MODEL_EFFORT=high

# Hard ceiling on API spend per UTC day. A normal digest costs ~$0.54; this is
# for the abnormal ones — a retry loop, a TOP_N typo, a workflow firing
# repeatedly. Once reached, model calls are refused and the pipeline degrades
# as if the model were unreachable, so the digest still goes out. Tracked in
# the database, so a crash-loop cannot reset it. 0 disables it.
DAILY_BUDGET_USD=2.00

# =============================================================================
# FILTERS — sensible defaults, change only if you want different results
# =============================================================================

# Term to keep (substring match). Empty keeps every term.
TERM_FILTER=Summer 2027
# How recent a posting must be to count as new.
WINDOW_HOURS=24
# How many top matches get a tailored resume and cover letter. The rest are
# listed link-only, so nothing is silently dropped.
TOP_N=10
# One application per employer per day — see config.py for why.
MAX_PER_COMPANY=1
TARGET_CATEGORIES=Software Engineering,AI / ML / Data,Quant
# Drop postings the source has marked closed.
ACTIVE_ONLY=true

# Sponsorship statuses to drop. For someone who needs visa sponsorship, a role
# requiring US citizenship or a clearance is not an opportunity.
#
# No source reliably publishes this — every posting reports "Unknown" — so the
# status is derived from the posting text (clearance / ITAR / "cannot sponsor"),
# and only the ATS sources publish text to read. Postings that stay Unknown are
# kept; treating silence as a rejection would discard most of the corpus.
# Add "Unknown" here if you only ever want confirmed sponsors.
EXCLUDE_SPONSORSHIP=No,US citizens only

# Drop internships that require a Master's or PhD. "Bachelor's or Master's" is
# either/or and is kept; so is a posting that says nothing about degree level.
UNDERGRADUATE_ONLY=true

# Which sources to run. The credentialed ones no-op when unconfigured, so
# leaving them in costs nothing.
SOURCES=greenhouse,lever,ashby,simplify,vansh,websearch,linkedin

# =============================================================================
# ADVANCED — you almost certainly do not need to change these
# =============================================================================

# Which Composio search tool backs the web-search source.
SEARCH_SLUG=COMPOSIO_SEARCH_TAVILY
FETCH_URL_SLUG=COMPOSIO_SEARCH_FETCH_URL_CONTENT

# Seen-postings / sent-digest database. Deleting it makes everything look new
# again, which will re-send postings you have already been emailed.
DB_PATH=internships.db

# Used to decide when "3pm" is, for the scheduled run.
DIGEST_TIMEZONE=America/Chicago

# --- Legacy: the Google Sheets sink and Ollama enrichment ---------------------
# Both predate the digest and are unrelated to it. Leave blank unless you use
# `main.py --sheets` or `--enrich`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
GOOGLE_CREDENTIALS_FILE=credentials.json
SPREADSHEET_ID=
SHEET_NAME=Internships
